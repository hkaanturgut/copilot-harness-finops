# Shot 4: the whole agent is one file. Harness, tools, policy, instruction order.
Output video/out/04-azure-yaml.mp4
Source video/tapes/_setup.tape
Set FontSize 18
Hide
Type "alias view='pygmentize -O style=monokai -f terminal256' && clear" Enter
Sleep 1s
Show
Set TypingSpeed 20ms
Type "view azure.yaml | sed -n '42,54p;96,106p'"
Enter
Sleep 13s
Type "clear && view azure.yaml | sed -n '73,92p'"
Enter
Sleep 13s
