# Shared settings. Hidden setup: venv, preview flag, clean prompt.
Set Shell zsh
Set FontSize 20
Set Width 1600
Set Height 900
Set Padding 24
Set TypingSpeed 35ms
Set Theme "Catppuccin Mocha"
Hide
Type "cd ~/repos/hkaanturgut/copilot-harness-finops && . .venv/bin/activate && export AZD_ALPHA_ENABLE_AGENTS_MANAGED_HARNESS=true && export PROMPT='%F{cyan}finops%f $ ' && clear" Enter
Sleep 2s
Show
